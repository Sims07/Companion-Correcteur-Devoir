{
  "name": "companion-correcteur-devoir",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "test:coverage:core": "vitest run --coverage --coverage.include='src/domain/**' --coverage.include='src/application/**' --coverage.reportsDirectory=coverage-unit-core",
    "test:coverage:report": "node scripts/update-coverage-badge.mjs",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "pdfjs-dist": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "read-excel-file": "latest"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "storybook": "10.6.5",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "jsdom": "latest",
    "fake-indexeddb": "latest",
    "@vitest/coverage-v8": "latest",
    "@playwright/test": "1.64.1"
  }
}
