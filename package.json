{
  "name": "companion-correcteur-devoir",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "test:coverage:core": "vitest run --coverage --coverage.include='src/domain/**' --coverage.include='src/application/**' --coverage.reportsDirectory=coverage-unit-core",
    "test:coverage:report": "node scripts/update-coverage-badge.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "pdfjs-dist": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "mammoth": "latest",
    "read-excel-file": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "jsdom": "latest",
    "fake-indexeddb": "latest",
    "@vitest/coverage-v8": "latest"
  }
}
